LLM_PROVIDER=deepseek
LLM_API_KEY=replace-with-your-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
MAX_LLM_INPUT_CHARS=60000
BATCH_PARSE_ITEM_TIMEOUT_MS=300000
ENABLE_PDF_VISION_OCR=true
PDF_TEXT_PAGE_MIN_CHARS=40
# Use a vision-capable model for scanned/image-only PDF pages.
# If omitted, the parser falls back to LLM_MODEL, which may fail when the model does not support images.
PDF_VISION_OCR_MODEL=

# Optional LangSmith tracing. Disabled by default.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=resume-screening

# Optional QQ Mail IMAP intake. In the desktop app, configure these in Settings instead.
QQ_MAIL_ADDRESS=
QQ_MAIL_AUTH_CODE=
QQ_MAIL_ENABLED=false
QQ_MAIL_POLL_SECONDS=120
